# LedgerFlow backend configuration (copy to backend/.env). All values have safe local defaults.
DATABASE_URL=postgresql+psycopg://ledgerflow:ledgerflow@localhost:5432/ledgerflow
SECRET_KEY=change-me-to-a-long-random-string
DEMO_PASSWORD=ledgerflow-demo
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_MB=20

# OCR (Tesseract must be installed: `brew install tesseract` / `apt-get install tesseract-ocr`)
# TESSERACT_CMD=/opt/homebrew/bin/tesseract
OCR_DPI=300

# Optional free local LLM fallback via Ollama (https://ollama.com). Set LLM_PROVIDER=none to disable.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Worker: run `make worker` (separate process) or set EMBEDDED_WORKER=true to run inside the API process.
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2

# Demo pacing: optional pause between stages so a live audience can follow the timeline (0 = off).
# It is shown in the UI when enabled and is never counted in recorded stage durations.
DEMO_STAGE_PACING_MS=0
